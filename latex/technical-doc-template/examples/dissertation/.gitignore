# LaTeX build artifacts — keep the folder clean if compiled in place.
# Preview images and the PDFs under examples/ are committed deliberately.

# Compiled output (anchored, so PDF figures and example PDFs are not ignored)
/main.pdf

# latexmk
*.fdb_latexmk
*.fls

# Core auxiliary files
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz
*.synctex(busy)
*.synctex.gz(busy)
*.xdv
*.nav
*.snm
*.vrb

# Bibliography
*.bbl
*.blg
*.bcf
*.run.xml

# Nomenclature (nomencl)
*.nlo
*.nls
*.ilg

# Index / glossaries / acronyms
*.idx
*.ind
*.glg
*.glo
*.gls
*.glsdefs
*.ist
*.acn
*.acr
*.alg

# minted and other tool output
_minted*/
*.pyg
*.bak
*.tmp
*.dpth
*.md5

# Output directories (if you use them)
build/
out/
dist/

# Editor / OS noise
*.swp
*~
.DS_Store
Thumbs.db
.vscode/
.idea/
.texstudio/
*.texstudio
